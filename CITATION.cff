    given-names: "Muhammad"
    orcid: "https://orcid.org/0009-0007-3877-2232"
version: "1.0.0"
date-released: "2026-11-03"
license: MIT
repository-code: "https://github.com/Muhammad5heraz/promoter-motif-scanner"
keywords:
  - promoter analysis
  - cis-regulatory elements
  - motif scanning
  - bioinformatics
  - plant genomics
